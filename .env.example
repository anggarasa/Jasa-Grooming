# Application
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/tampilkit_booking?schema=public"

# MinIO Object Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="your_minio_access_key"
MINIO_SECRET_KEY="your_minio_secret_key"
MINIO_BUCKET="tampilkit-booking"

# Authentication (JWT Secrets - minimal 32 karakter)
JWT_ACCESS_SECRET="pawcare-access-secret-key-min-32-chars-long-tampilkit"
JWT_REFRESH_SECRET="pawcare-refresh-secret-key-min-32-chars-long-tampilkit"
JWT_ISSUER="pawcare-grooming"
JWT_AUDIENCE="pawcare-admin"

# Google Calendar OAuth & Synchronization (Phase 07)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
GOOGLE_OAUTH_STATE_SECRET="google-oauth-state-secret-min-32-chars-long-tampilkit"
GOOGLE_TOKEN_ENCRYPTION_KEY="pawcare-google-token-encryption-key-min-32-chars!"
GOOGLE_CALENDAR_SYNC_ENABLED=true
GOOGLE_CALENDAR_WEBHOOK_URL="https://your-domain.com/api/webhooks/google-calendar"
GOOGLE_CALENDAR_WEBHOOK_TOKEN="your_random_webhook_verification_token"
GOOGLE_CALENDAR_SYNC_INTERVAL_MINUTES=15
GOOGLE_CALENDAR_RETRY_MAX_ATTEMPTS=5
GOOGLE_CALENDAR_FREEBUSY_TIMEOUT_MS=2000
