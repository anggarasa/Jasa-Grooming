datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  passwordHash      String
  role              Role          @default(OWNER)
  isActive          Boolean       @default(true)
  tokenVersion      Int           @default(0)
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sessions          AuthSession[]
  auditLogs         AuthAuditLog[]
  resolvedCalendarConflicts CalendarSyncConflict[]

  @@map("users")
}

model AuthSession {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent     String?
  ipAddress     String?
  isRevoked     Boolean              @default(false)
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  refreshTokens RefreshTokenRecord[]

  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshTokenRecord {
  id                String      @id @default(cuid())
  sessionId         String
  session           AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash         String      @unique
  isUsed            Boolean     @default(false)
  replacedByTokenId String?
  replacedAt        DateTime?
  createdAt         DateTime    @default(now())

  @@index([sessionId, isUsed])
  @@map("refresh_token_records")
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("auth_audit_logs")
}

model Business {
  id                  String                  @id @default(cuid())
  name                String
  slug                String                  @unique
  description         String?
  email               String?
  phone               String?
  whatsapp            String?
  address             String?
  fullAddress         String?
  city                String?
  province            String?
  postalCode          String?
  googleMapsUrl       String?
  timezone            String                  @default("Asia/Jakarta")
  logoObjectKey       String?
  status              String                  @default("ACTIVE")
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  settings            BusinessSetting?
  operatingHours      BusinessOperatingHour[]
  galleryItems        BusinessGallery[]
  mediaAssets         MediaAsset[]
  serviceCategories   ServiceCategory[]
  services            Service[]
  customers           Customer[]
  bookings            Booking[]
  bookingResources    BookingResource[]
  resourceBlocks      ResourceBlock[]
  calendarConnections CalendarConnection[]

  @@map("businesses")
}

model BusinessSetting {
  id                      String   @id @default(cuid())
  businessId              String   @unique
  business                Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingEnabled          Boolean  @default(true)
  currency                String   @default("IDR")
  bookingIntervalMinutes  Int      @default(30)
  defaultBufferMinutes    Int      @default(15)
  minimumAdvanceMinutes   Int      @default(60)
  maximumAdvanceDays      Int      @default(30)
  cancellationWindowHours Int      @default(24)
  autoConfirmBooking      Boolean  @default(false)
  allowCustomerReschedule Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("business_settings")
}

model BusinessOperatingHour {
  id         String                   @id @default(cuid())
  businessId String
  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int                      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  isOpen     Boolean                  @default(true)
  openTime   String                   @default("09:00")
  closeTime  String                   @default("18:00")
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  breaks     BusinessOperatingBreak[]

  @@unique([businessId, dayOfWeek])
  @@index([businessId, dayOfWeek])
  @@map("business_operating_hours")
}

model BusinessOperatingBreak {
  id              String                @id @default(cuid())
  operatingHourId String
  operatingHour   BusinessOperatingHour @relation(fields: [operatingHourId], references: [id], onDelete: Cascade)
  startTime       String                // HH:mm
  endTime         String                // HH:mm
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([operatingHourId])
  @@map("business_operating_breaks")
}

model BusinessGallery {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  objectKey    String
  caption      String?
  altText      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, displayOrder])
  @@map("business_galleries")
}

model MediaAsset {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  objectKey    String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  folder       String   @default("uploads")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, folder])
  @@map("media_assets")
}

model ServiceCategory {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  services     Service[]

  @@unique([businessId, slug])
  @@index([businessId, displayOrder])
  @@map("service_categories")
}

model Service {
  id               String          @id @default(cuid())
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  description      String?
  shortDescription String?
  fullDescription  String?
  durationMinutes  Int             @default(60)
  bufferMinutes    Int             @default(15)
  price            Decimal         @db.Decimal(12, 2)
  imageObjectKey   String?
  displayOrder     Int             @default(0)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  bookings         Booking[]

  @@unique([businessId, slug])
  @@index([businessId, isActive])
  @@index([businessId, displayOrder])
  @@map("services")
}

model Customer {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  pets       Pet[]
  bookings   Booking[]

  @@index([businessId, phone])
  @@map("customers")
}

model Pet {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  type       String
  breed      String?
  age        Int?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  bookings   Booking[]

  @@index([customerId])
  @@map("pets")
}

model BookingResource {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  bookings       Booking[]
  resourceBlocks ResourceBlock[]

  @@index([businessId, isActive])
  @@map("booking_resources")
}

model Booking {
  id                      String                 @id @default(cuid())
  businessId              String
  business                Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resourceId              String
  resource                BookingResource        @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  customerId              String
  customer                Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  petId                   String
  pet                     Pet                    @relation(fields: [petId], references: [id], onDelete: Cascade)
  serviceId               String
  service                 Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingCode             String                 @unique
  startAt                 DateTime
  endAt                   DateTime
  serviceEndAt            DateTime
  occupancyEndAt          DateTime
  serviceNameSnapshot     String
  serviceDurationSnapshot Int
  servicePriceSnapshot    Decimal                @db.Decimal(12, 2)
  totalPrice              Decimal                @db.Decimal(12, 2)
  notes                   String?
  customerNotes           String?
  internalNotes           String?
  source                  String                 @default("PUBLIC_GUEST")
  lastModifiedByUserId    String?
  cancelledAt             DateTime?
  cancellationReason      String?
  status                  BookingStatus          @default(PENDING)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  calendarEventMapping    CalendarEventMapping?
  calendarSyncJobs        CalendarSyncJob[]
  calendarSyncConflicts   CalendarSyncConflict[]
  statusHistories         BookingStatusHistory[]
  rescheduleHistories     BookingRescheduleHistory[]
  auditLogs               BookingAuditLog[]
  accessTokens            BookingAccessToken[]
  idempotencyRecords      BookingIdempotency[]

  @@index([bookingCode])
  @@index([businessId, startAt])
  @@index([resourceId, startAt])
  @@index([status, startAt])
  @@index([occupancyEndAt])
  @@index([source])
  @@map("bookings")
}

model BookingStatusHistory {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus      BookingStatus?
  toStatus        BookingStatus
  reason          String?
  changedByUserId String?
  actorUserId     String?
  createdAt       DateTime      @default(now())

  @@index([bookingId, createdAt])
  @@map("booking_status_histories")
}

model BookingRescheduleHistory {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  previousStartAt DateTime
  previousEndAt   DateTime
  newStartAt      DateTime
  newEndAt        DateTime
  reason          String
  actorUserId     String?
  createdAt       DateTime @default(now())

  @@index([bookingId, createdAt])
  @@map("booking_reschedule_histories")
}

model ResourceBlock {
  id              String          @id @default(cuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        BookingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startAt         DateTime
  endAt           DateTime
  reason          String
  createdByUserId String?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  calendarEventMapping  CalendarEventMapping?
  calendarSyncJobs      CalendarSyncJob[]
  calendarSyncConflicts CalendarSyncConflict[]

  @@index([businessId, startAt])
  @@index([resourceId, startAt])
  @@index([cancelledAt])
  @@map("resource_blocks")
}

model BookingAuditLog {
  id          String   @id @default(cuid())
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  actorUserId String?
  action      String
  beforeData  Json?
  afterData   Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("booking_audit_logs")
}

model BookingAccessToken {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([bookingId])
  @@index([tokenHash])
  @@map("booking_access_tokens")
}

model BookingIdempotency {
  id                 String    @id @default(cuid())
  keyHash            String    @unique
  requestFingerprint String
  bookingId          String?
  booking            Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  responsePayload    Json?
  createdAt          DateTime  @default(now())
  expiresAt          DateTime

  @@index([expiresAt])
  @@map("booking_idempotencies")
}

model CalendarConnection {
  id                    String                         @id @default(cuid())
  businessId            String
  business              Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider              String                         @default("GOOGLE")
  googleAccountId       String?
  googleAccountEmail    String?
  calendarId            String?
  calendarName          String?
  calendarTimezone      String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  grantedScopes         String[]                       @default([])
  status                String                         @default("DISCONNECTED")
  lastSyncAt            DateTime?
  lastErrorAt           DateTime?
  lastErrorMessage      String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  eventMappings         CalendarEventMapping[]
  syncState             CalendarSyncState?
  webhookChannels       CalendarWebhookChannel[]
  externalBusyIntervals CalendarExternalBusyInterval[]
  syncJobs              CalendarSyncJob[]
  conflicts             CalendarSyncConflict[]

  @@unique([businessId, provider])
  @@index([businessId, status])
  @@map("calendar_connections")
}

model CalendarEventMapping {
  id                   String             @id @default(cuid())
  calendarConnectionId String
  calendarConnection   CalendarConnection @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)
  bookingId            String?            @unique
  booking              Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceBlockId      String?            @unique
  resourceBlock        ResourceBlock?     @relation(fields: [resourceBlockId], references: [id], onDelete: Cascade)
  externalEventId      String
  externalEventEtag    String?
  syncStatus           String             @default("SYNCED")
  lastSyncedAt         DateTime           @default(now())
  lastSyncError        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([calendarConnectionId, externalEventId])
  @@index([calendarConnectionId, syncStatus])
  @@map("calendar_event_mappings")
}

model CalendarSyncState {
  id                     String             @id @default(cuid())
  calendarConnectionId   String             @unique
  calendarConnection     CalendarConnection @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)
  nextSyncToken          String?
  lastFullSyncAt         DateTime?
  lastIncrementalSyncAt  DateTime?
  lastSuccessfulSyncAt   DateTime?
  syncStatus             String             @default("IDLE")
  lastError              String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("calendar_sync_states")
}

model CalendarWebhookChannel {
  id                    String             @id @default(cuid())
  calendarConnectionId  String
  calendarConnection    CalendarConnection @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)
  channelId             String             @unique
  resourceId            String
  verificationTokenHash String
  expirationAt          DateTime
  status                String             @default("ACTIVE")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([calendarConnectionId, status])
  @@index([expirationAt])
  @@map("calendar_webhook_channels")
}

model CalendarExternalBusyInterval {
  id                   String             @id @default(cuid())
  calendarConnectionId String
  calendarConnection   CalendarConnection @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)
  externalEventId      String
  startAt              DateTime
  endAt                DateTime
  isBusy               Boolean            @default(true)
  summary              String?
  lastObservedAt       DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([calendarConnectionId, externalEventId])
  @@index([calendarConnectionId, startAt, endAt])
  @@index([startAt, endAt])
  @@map("calendar_external_busy_intervals")
}

model CalendarSyncJob {
  id                   String             @id @default(cuid())
  calendarConnectionId String
  calendarConnection   CalendarConnection @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)
  bookingId            String?
  booking              Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  resourceBlockId      String?
  resourceBlock        ResourceBlock?     @relation(fields: [resourceBlockId], references: [id], onDelete: SetNull)
  operationType        String
  payload              Json?
  aggregateVersion     Int                @default(1)
  status               String             @default("PENDING")
  attemptCount         Int                @default(0)
  maxAttempts          Int                @default(5)
  nextAttemptAt        DateTime           @default(now())
  lockedUntil          DateTime?
  lockedBy             String?
  lastError            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, nextAttemptAt, lockedUntil])
  @@index([calendarConnectionId, status])
  @@index([bookingId])
  @@index([resourceBlockId])
  @@map("calendar_sync_jobs")
}

model CalendarSyncConflict {
  id                   String             @id @default(cuid())
  calendarConnectionId String
  calendarConnection   CalendarConnection @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)
  bookingId            String?
  booking              Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  resourceBlockId      String?
  resourceBlock        ResourceBlock?     @relation(fields: [resourceBlockId], references: [id], onDelete: SetNull)
  externalEventId      String?
  conflictType         String
  localSnapshot        Json
  remoteSnapshot       Json
  status               String             @default("PENDING")
  detectedAt           DateTime           @default(now())
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolvedByUser       User?              @relation(fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolutionNotes      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([calendarConnectionId, status])
  @@index([bookingId])
  @@index([detectedAt])
  @@map("calendar_sync_conflicts")
}

