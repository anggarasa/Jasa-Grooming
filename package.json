{
  "name": "tampilkit-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev frontend",
    "build": "prisma generate && node --max-old-space-size=2048 ./node_modules/next/dist/bin/next build frontend",
    "start": "next start frontend",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "auth": "tsx backend/scripts/bootstrap-owner.ts",
    "auth:provision": "tsx backend/scripts/bootstrap-owner.ts",
    "calendar:worker": "tsx backend/workers/calendar-worker.ts",
    "calendar:sync": "tsx backend/workers/calendar-sync.ts",
    "calendar:reconcile": "tsx backend/workers/calendar-reconcile.ts",
    "calendar:renew-watches": "tsx backend/workers/renew-watches.ts",
    "backup:drill": "tsx backend/scripts/backup-restore-drill.ts",
    "test:frontend": "vitest run frontend/tests",
    "test:backend": "vitest run backend/tests",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "tsx backend/prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.3.1",
    "googleapis": "^188.0.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "minio": "^8.0.7",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
